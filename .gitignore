# big or rebuildable stuff - never commit these
data/raw/
data/processed/
adapters/
deploy/merged/
deploy/mlc/
archive/old_adapter/
archive/quarantine/*.quarantined
*.safetensors
*.bin
*.pt

# rating keys must never end up anywhere raters can see them
results/rating_sheets/*KEY*

# python / notebooks
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.env

# Local baseline model cache and private rating keys
.cache/
results/experiment_01/*key*.json

results/experiment_01/**/KEY*.json

# Private advisory notes, never committed
docs/SUPERVISOR_REVIEW_*.md

# Secrets and private material (keep these outside the repository)
.env.*
!.env.example
private/
*.pem
*.key
*.p12
*.pfx
id_rsa*
*credentials*.json
# Raw or real conversations, chat exports, participant responses and completed rating sheets
*chat*export*
*conversation*export*
data/private/
results/rating_sheets/completed/
results/**/ratings_raw*
# More weight formats (adapters stay in adapters/, which is already ignored)
*.gguf
*.ckpt
*.pth
# Scratch and personal notes
scratch/
notes.local.md
*.private.md

# Local-only working notes, kept out of the repository
AGENTS.md
docs/WRITING_VOICE_GUIDE.md
